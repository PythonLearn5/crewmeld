{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Next.js App (bun)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--env-file=../../.env",
        "--inspect=9229",
        "next",
        "dev",
        "--port",
        "6100",
        "--hostname",
        "0.0.0.0"
      ],
      "cwd": "${workspaceFolder}/apps/crewmeld",
      "port": 9229,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Attach to bun (port 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "cwd": "${workspaceFolder}/apps/crewmeld"
    }
  ]
}
